# YouTube Data API v3 key — LOCAL ONLY (the pipeline runs locally / in the
# refresh workflow; Vercel builds from committed JSON and never sees it).
YT_API_KEY=your_key_here

# Local engine co-development: nuxt.config extends this path when set;
# Vercel leaves it unset and pulls the pinned github: tag.
# ENGINE_PATH=../replay-engine

# Canonical origin for SEO/OG/sitemap URLs (set per Vercel project).
# NUXT_PUBLIC_SITE_URL=https://tekken-replay-database.vercel.app

# Netscape-format youtube.com cookie export for the Evo frame downloads
# (scripts/hud-frames.ts — cookieless hits YouTube's bot-check immediately).
# Defaults to secrets/yt-cookies.txt, which .gitignore and .vercelignore both
# cover. It is a LIVE GOOGLE SESSION: chmod 600, never commit it.
# EVO_COOKIES=/absolute/path/to/yt-cookies.txt

# Politeness pacing for those downloads (seconds, randomized per attempt).
# EVO_SLEEP_MIN=1
# EVO_SLEEP_MAX=3
